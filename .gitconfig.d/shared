[alias]
  st = status
  ci = commit
  br = branch
  co = checkout
  df = diff --color
  lg = log -p
  lp = log --oneline --graph --color
  dfw = diff --word-diff=color
  nudge = push --force-with-lease
[color]
  status = true
  diff = true
  ui = true
[core]
  pager = "less -FXR"
  editor = nvim
  preloadindex = true
  excludesfile = ~/.gitconfig.d/gitignore
[merge]
  tool = nvimdiff
  conflictstyle = zdiff3
[push]
  default = simple
  autoSetupRemote = true
[pull]
  rebase = true
[fetch]
  prune = true
[rebase]
  autosquash = true
[diff]
  colorMoved = default
[init]
  defaultBranch = main
[branch]
  sort = -committerdate
